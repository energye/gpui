 // Draw replays the case ops on dc. Paths in ops (images, fonts) resolve
 // against baseDir.
 func Draw(dc *render.Context, c *Case, baseDir string) error {
+	// P1.8 negative controls (temporary, env-gated, reverted after the run):
+	// GPUI_NEG_SHIFT_1PX=1 shifts every fill_rect by 1px (pixel assertion must
+	// go red); GPUI_NEG_SKIP_DRAW=1 skips exactly one non-clear draw (the
+	// gpu_ops logic probe must go red).
+	shift := os.Getenv("GPUI_NEG_SHIFT_1PX") == "1"
+	skipDraw := os.Getenv("GPUI_NEG_SKIP_DRAW") == "1"
+	skipped := false
 	for i := range c.Ops {
 		op := &c.Ops[i]
+		if skipDraw && !skipped && op.Kind != OpClear {
+			skipped = true
+			continue
+		}
+		if shift && op.Kind == OpFillRect {
+			op.Rect[0] += 1
+			op.Rect[1] += 1
+		}
 		if err := drawOp(dc, op, baseDir); err != nil {
